# ============================================
# 多 Agent 协作系统 v48.0 - 环境变量配置模板
# ============================================
# 使用方法：
#   1. 复制此文件为 .env
#   2. 填入你的实际配置值
#   3. 不要将 .env 提交到版本控制
# ============================================

# ---------- LLM 配置（必填） ----------
# 当前系统默认使用 DeepSeek Chat 模型（兼容 OpenAI API 格式）
# 请至少配置一个 API Key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- LLM 配置（可选，切换后端时使用） ----------
# OpenAI（如需切换）
# OPENAI_API_KEY=sk-your-openai-api-key-here
# OPENAI_MODEL_NAME=gpt-4-turbo-preview
# OPENAI_TEMPERATURE=0.7

# 智谱 GLM（如需切换）
# ZHIPU_API_KEY=your-zhipu-api-key-here

# Anthropic（如需切换）
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
# ANTHROPIC_MODEL_NAME=claude-3-opus-20240229

# 本地模型（可选，使用 Ollama 等）
# LOCAL_MODEL_URL=http://localhost:11434
# LOCAL_MODEL_NAME=llama2

# ---------- 数据库配置（可选） ----------
# 系统内置 SQLite 支持，无需额外配置
# 如需连接外部数据库，请配置以下参数
DB_HOST=localhost
DB_PORT=5432
DB_NAME=multi_agent
DB_USER=postgres
DB_PASSWORD=your-db-password

# MySQL 配置（如需）
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your-mysql-password
# MYSQL_DATABASE=multi_agent

# ---------- 应用配置 ----------
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ---------- Agent 配置 ----------
# Agent 最大循环步数（默认 500）
AGENT_MAX_ITERATIONS=500
# Agent 详细日志输出
AGENT_VERBOSE=true

# ---------- HITL 人工审批配置 ----------
# 启用人工审批（true/false）
ENABLE_HITL=true
# 审批模式：none（免审批）| dangerous_only（高危审批）
APPROVAL_MODE=dangerous_only
# 审批超时时间（秒）
APPROVAL_TIMEOUT=60

# ---------- LLM 调用配置 ----------
# LLM 调用超时时间（秒）
LLM_TIMEOUT=120
# LLM 最大重试次数
LLM_MAX_RETRIES=3

# ---------- Redis（可选，用于 Agent 状态缓存） ----------
# REDIS_URL=redis://localhost:6379/0
